# Email service configuration (required for the contact form to send emails)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The "from" email address — must be on a domain verified in your Resend account.
# Verified domain: kryptondigital.co.uk
RESEND_FROM_EMAIL=Krypton Digital <noreply@kryptondigital.co.uk>

# The email address that receives contact form submissions.
# Use contact@kryptondigital.co.uk (your verified domain with a real inbox).
# Using the .com address caused bounces because that mailbox isn't set up
# to receive mail on Google Workspace.
CONTACT_TO_EMAIL=contact@kryptondigital.co.uk
